# Histórico de comandos do Nushell (config.nu usa history.file_format = "sqlite").
# O banco muda a cada comando digitado, e -shm/-wal são arquivos temporários do
# modo WAL do SQLite que só existem com o shell aberto — versioná-los gera
# conflito em todo merge e publica o histórico de comandos.
nushell/history.*

# Repositório git próprio (MiaSchionato/pure-nvim). Versionar aqui gravaria um
# gitlink sem registrar o remote, e um clone novo traria a pasta vazia.
nvim/

# Estado de ferramentas, não configuração.
github-copilot/

# Backups made before editing a config (kept locally, not configuration).
*.bak
*.bak/
*.before-fixes-*

# yasb writes its log next to its config.
yasb/*.log

# Copies made before each change to the desktop stack (kept locally).
*.before-*
*.backup-*
*.running-*
*.retired-*
kanata/kanata.kbd.komokana-*

# gh keeps its login token in hosts.yml.
gh/

# yasb run from its source: a git clone of its own (the kanata_mode widget is
# on its local branch kanata-mode; a copy lives in yasb/widgets/).
yasb-src/
