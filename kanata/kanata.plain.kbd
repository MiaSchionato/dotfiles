;; ============================================================================
;;  NO WHKD (kanata.plain.kbd), 2026-10-09: every command whkd used to run is now
;;  run by kanata itself (cmd; the cmd_allowed build, as a normal user):
;;  the GlazeWM CLI and programs straight; what needs logic (is
;;  the app running?) in nushell (nu -c), Windows paths in backticks.
;;  cmd.exe could not take the quotes kanata sends. Win+O reloads (lrld).
;;  Kanata Configuration - Ported from AutoHotkey (~/Documents/AutoHotkey)
;;
;;  Features:
;;    1. CapsLock Dual-Role:
;;       - Tap: Esc
;;       - Shift + Tap: Delete
;;       - Hold: caps_nav layer (vim arrows h/j/k/l + dead keys e/`/i/n/c)
;;    2. macOS-Style Dead Keys (Accents):
;;       - Triggerable via CapsLock + [e, `, i, n, c] OR Alt + [e, `, i, n, c]
;;       - Acute (e): á, é, í, ó, ú, Á, É, Í, Ó, Ú, ç, Ç
;;       - Grave (`): à, è, ì, ò, ù, À, È, Ì, Ò, Ù
;;       - Circumflex (i): â, ê, î, ô, û, Â, Ê, Î, Ô, Û
;;       - Tilde (n): ã, õ, ñ, Ã, Õ, Ñ
;;       - Cedilla (c): ç, Ç
;;    3. Windows / Super as Command (Cmd):
;;       - Tap Left Win: Alt+Space (app launcher, suppresses Windows Start menu)
;;       - Hold Left Win: cmd_layer
;;         * Cmd+A -> Ctrl+A
;;         * Cmd+C -> Ctrl+C (Shift+Cmd+C -> Komorebi clear-session-float)
;;         * Cmd+X -> Ctrl+X
;;         * Cmd+V -> Ctrl+V
;;         * Cmd+Z -> Ctrl+Z / Ctrl+Shift+Z
;;         * Cmd+T -> Ctrl+T
;;         * Cmd+W -> Alt+F4 (close window)
;;         * Cmd+Tab -> Alt+Tab (window switcher)
;;         * Passthrough Komorebi navigation (Win+1..5, Win+hjkl, etc.)
;;    4. Ctrl Key Additions:
;;       - Ctrl+H -> Ctrl+Win+Left (Virtual Desktop left)
;;       - Ctrl+L -> Ctrl+Win+Right (Virtual Desktop right)
;;       - Ctrl+V -> Win+V (Windows Clipboard History)
;; ============================================================================

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; kanata runs the window commands itself (cmd): whkd is gone.
  danger-enable-cmd yes
)

;; ----------------------------------------------------------------------------
;; Source Keyboard Layout (Standard 60% ANSI physical keys)
;; ----------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl f13 lalt           spc            ralt rmet rctl
  ;; Win + mouse buttons (see vk-lclick / vk-rclick). On Windows kanata only starts
  ;; handling the mouse after a restart, not a reload.
  mlft
  mrgt
  mmid
)

;; ----------------------------------------------------------------------------
;; Virtual keys
;; ----------------------------------------------------------------------------
;; Alt held down across several key presses: Win+Tab presses it, releasing
;; Win releases it (see @win and @w-tab).
(defvirtualkeys
  vk-alt lalt
  vk-win f24
  ;; Win + left / right / middle click become these keys (kanata releases them after
  ;; ~20 ms), so windows.ahk gets ONE event in order and the program under the
  ;; cursor never sees the click.
  vk-lclick f20
  vk-rclick f21
  vk-mclick f19
  ;; Quick look (CapsLock+B, see @glance): tapped when B is let go, it goes back to
  ;; the workspace you were on (kept in a temp file by @glance).
  vk-glance-end (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); if ($f | path exists) { let p = (open $f | str trim); rm $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace $p }")
)

;; ----------------------------------------------------------------------------
;; Aliases & Macros
;; ----------------------------------------------------------------------------
(defalias
  ;; Win + mouse buttons inside the Win layers; with the Win+Tab switcher open
  ;; (vk-alt held) they are normal clicks, to pick the window there.
  win-lclick (switch
               ((input virtual vk-alt)) mlft break
               () (multi (on-press press-vkey vk-lclick) (on-release release-vkey vk-lclick)) break)
  win-rclick (switch
               ((input virtual vk-alt)) mrgt break
               () (multi (on-press press-vkey vk-rclick) (on-release release-vkey vk-rclick)) break)
  win-mclick (switch
               ((input virtual vk-alt)) mmid break
               () (multi (on-press press-vkey vk-mclick) (on-release release-vkey vk-mclick)) break)

  ;; CapsLock: Tap = Esc, Shift+Tap = Delete, Hold = caps_nav layer.
  ;; Esc is sent directly now; the Editor variant lives in @cap-del and
  ;; komokana picks between them, so no AutoHotkey round trip.
  ;; Shift+CapsLock: a tap is still Delete, but held it is caps_nav too, so
  ;; Shift+Caps+C gives Ç (it was a plain Delete, held or not; 2026-10-08).
  cap (fork
        (tap-hold-press 200 200 esc (layer-while-held caps_nav))
        (tap-hold-press 200 200 del (layer-while-held caps_nav))
        (lsft rsft))

  ;; Left Win / Cmd: Tap = Alt+Space (launcher), Hold = cmd_layer.
  ;; Releasing it also lets go of the Alt that Win+Tab holds (@w-tab).
  win (tap-hold-press 200 200 A-spc
        (multi (layer-while-held cmd_layer) (on-press press-vkey vk-win) (on-release release-vkey vk-alt) (on-release release-vkey vk-win)))

  ;; --- Per-application variants, selected by komokana ---
  ;; komokana swaps the BASE layer on focus change, so each variant is the
  ;; base layer with one alias replaced. Everything else stays identical.

  ;; CapsLock inside Editor: tap sends Delete instead of Esc. Hold and
  ;; Shift+tap are unchanged.
  cap-del (fork
            (tap-hold-press 200 200 del (layer-while-held caps_nav))
            (tap-hold-press 200 200 del (layer-while-held caps_nav))
            (lsft rsft))

  ;; Left Win inside Zen: same tap (launcher), but the hold reaches a cmd
  ;; layer whose W closes a tab instead of a window.
  win-zen (tap-hold-press 200 200 A-spc
            (multi (layer-while-held cmd_zen) (on-press press-vkey vk-win) (on-release release-vkey vk-alt) (on-release release-vkey vk-win)))

  ;; Win+W outside a browser. (GlazeWM CLI: close)
  ;; close, so kanata never runs a command itself.
  w-kill (cmd C:\PROGRA~1\glzr.io\GlazeWM\cli\glazewm.exe command close)

  ;; Alt+R / Alt+P: GlazeWM redraw / pause.
  a-retile (cmd C:\PROGRA~1\glzr.io\GlazeWM\cli\glazewm.exe command wm-redraw)
  a-pause (cmd C:\PROGRA~1\glzr.io\GlazeWM\cli\glazewm.exe command wm-toggle-pause)
  ;; Left Alt: normal Alt + activates alt_accent layer for dead keys
  ;; Quick look: hold CapsLock, press and HOLD B: the Browser workspace shows
  ;; while B is down; letting go of B goes back to the workspace you were on
  ;; (test key and workspace, 2026-10-14). It was Alt+B, then a hook on CapsLock's
  ;; release, but a virtual key tapped on CapsLock's release used up the pending
  ;; dead key (accents stopped waiting for the vowel). The one you left is kept in
  ;; a temp file.
  glance (multi (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); let n = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $n != 'Browser' { $n | save -f $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Browser }")
                (on-release tap-vkey vk-glance-end))

  ;; The same quick look for the other workspaces: CapsLock + V (Nvim; N is the
  ;; tilde), P (Editor), R (Motion), G (Scratchpad). Same keys as the Win
  ;; layer, where they GO to the workspace instead of just looking.
  gl-nv (multi (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); let n = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $n != 'Nvim' { $n | save -f $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Nvim }")
                (on-release tap-vkey vk-glance-end))
  gl-pr (multi (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); let n = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $n != 'Editor' { $n | save -f $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Editor }")
                (on-release tap-vkey vk-glance-end))
  gl-af (multi (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); let n = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $n != 'Motion' { $n | save -f $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Motion }")
                (on-release tap-vkey vk-glance-end))
  gl-sp (multi (cmd nu -c "let f = ($env.TEMP | path join 'glaze-glance-prev'); let n = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $n != 'Scratchpad' { $n | save -f $f; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Scratchpad }")
                (on-release tap-vkey vk-glance-end))

  alt (multi lalt (layer-while-held alt_accent))

  ;; Left Ctrl: normal Ctrl + activates ctrl_nav layer
  ctl (multi lctl (layer-while-held ctrl_nav))

  ;; Clipboard History: releases Ctrl and sends Win+V
  clip (multi (release-key lctl) M-v)

  ;; Command layer aliases
  undo  (fork C-z C-S-z (lsft rsft))
  ;; Win+Q: force quit; with the Win+Tab switcher open (vk-alt held),
  ;; Delete instead, which closes the window selected there and keeps the
  ;; switcher open (Mia, 2026-10-08).
  ;; Force quit: kill the process of the focused window. nu has no Win32 calls, so the
  ;; foreground PID comes from an inline powershell (-EncodedCommand: GetForegroundWindow +
  ;; GetWindowThreadProcessId), and nu does the rest: skips the shell and the input stack
  ;; (explorer, GlazeWM, kanata, AutoHotkey, yasb) and kills the rest. Takes ~1 s
  ;; (powershell start-up). Replaces AutoHotkey's F23 KillFocused (2026-10-14).
  m-q (switch
        ((input virtual vk-alt)) del break
        () (cmd nu -c "let p = (powershell -NoProfile -EncodedCommand  | str trim | into int); let n = (ps | where pid == $p | get name | first | str downcase); if $n not-in ['explorer.exe' 'glazewm.exe' 'kanata_windows_tty_winiov2_cmd_allowed_x64.exe' 'autohotkey64.exe' 'yasb.exe' 'pythonw.exe'] { kill -f $p }") break)
  ;; w-cls A-f4 ;; for now, it should be ctrl + w when on zen browser
  ;; Win+W closes the window with Alt+F4 straight from kanata (Mia, 2026-10-07):
  ;; closing through the WM failed on windows it does not manage (floating
  ;; Adobe apps). cmd_zen still sends Ctrl+W, closing a tab in Zen.
  w-cls (macro F22) ;; Win+W: windows.ahk decides (Ctrl+W in Zen / Premiere / Filmcraft, else Alt+F4)
  ;; Win+Tab as macOS Cmd+Tab (Mia, 2026-10-08): the first Tab presses Alt
  ;; and keeps it down while Win is held, so each Tab steps through Windows'
  ;; Alt+Tab switcher and releasing Win picks the window, no Enter. It was
  ;; Ctrl+Alt+Tab, the sticky switcher that waits for Enter. Win+Shift+Tab
  ;; goes back (Shift passes through).
  ;; The Tab waits 5 ms for the Alt: sent together, the first Tab went out
  ;; before Alt was down (a plain Tab), and the switcher took a second one.
  w-tab (multi (on-press press-vkey vk-alt) (macro 5 tab))
  c-cpy (fork C-c M-S-c (lsft rsft))
  ;; Win+S saves (Ctrl+S); Win+Shift+S is Windows' screenshot (Snipping
  ;; Tool), which Ctrl+Shift+S used to take.
  c-save (fork C-s M-S-s (lsft rsft))
  expl (macro F23) ;; Win+E: windows.ahk goes to the File Explorer that is open, or opens one
  ;; Win+D stays show-desktop; Win+Shift+D reaches whkd instead.
  ;; Scratchpad workspace (notes: "Linux vs windows", Omarchy parity; Mia, 2026-10-14).
  ;; Win+G: go to the Scratchpad workspace, or back to the one before when already
  ;; there (nu decides: it reads GlazeWM's focused
  ;; workspace). Win+Shift+G: send the focused window there and stay.
  ;; Ctrl + . opens Windows' emoji panel (Win + . is the workspace to the right in the Win layer,
  ;; and Win + V is paste, so the real Win shortcuts are out of reach). Base and Zen layers only.
  emoji (fork . (macro M-.) (lctl rctl))
  m-p (fork (fork (macro F18) (macro A-F18) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Photo' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Photo; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Photo' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Photo }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft)) ;; Win+P: Photo
  m-ed (fork (fork (macro F13) (macro A-F13) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Editor' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Editor; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Editor' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Editor }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft)) ;; Win+Space: Editor (Alt: pull here, Shift: move the window and follow)
  m-mo (fork (fork (macro F14) (macro A-F14) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Motion' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Motion; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Motion' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Motion }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft)) ;; Win+M: Motion
  m-scr (fork (fork (macro F15) (macro A-F15) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Scratchpad' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Scratchpad; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft)) ;; Win+Backspace: Scratchpad (Shift: send the window there, no follow)
  m-desk (fork M-d (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Motion' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Motion; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Motion' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Motion }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft))
  m-[ (macro C-A-M-[) ;; cycle-focus
  m-] (macro C-A-M-]) 
  

  m-f (fork (macro C-A-M-f) (macro S-C-A-M-f) (lsft rsft))
  ;; Vim keys move windows focus
  m-h (fork (macro C-A-M-h) (macro S-C-A-M-h) (lsft rsft)) ;; using macro to avoid kanata error 
  m-j (fork (macro C-A-M-j) (macro S-C-A-M-j) (lsft rsft))
  m-k (fork (macro C-A-M-k) (macro S-C-A-M-k) (lsft rsft))
  m-l (fork (macro C-A-M-l) (macro S-C-A-M-l) (lsft rsft))

  m-i (macro C-A-M-i) ;; toggle-shortcuts (?)
  m-o (fork lrld (macro S-C-A-M-o) (lsft rsft)) ;; Reload whkd and Komorebi 

  m-1 (fork (macro C-A-M-1) (macro C-F13) (lsft rsft)) ;; focus monitor 1 (Shift: send this workspace to it)
  m-2 (fork (macro C-A-M-2) (macro C-F14) (lsft rsft)) ;; focus monitor 2 (Shift: send this workspace to it)
  m-3 (fork (macro C-A-M-3) (macro C-F15) (lsft rsft)) ;; focus monitor 3 (Shift: send this workspace to it)
  m-4 (macro C-A-M-4)
  m-5 (macro C-A-M-5)
  m-6 (macro C-A-M-6)
  m-7 (macro C-A-M-7)
  m-8 (macro C-A-M-8)
  m-9 (macro C-A-M-9)
  m-0 (macro C-A-M-0)


  m-term (cmd "C:\Program Files\WezTerm\wezterm-gui.exe") ;; terminal
  m-b (fork (fork (macro F16) (macro A-F16) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Browser' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Browser; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Browser' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Browser }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft))
  m-n (fork (fork (macro F17) (macro A-F17) (lalt ralt)) (cmd nu -c "let cur = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first); if $cur != 'Nvim' { let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace Nvim; if (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query workspaces | from json | get data.workspaces | where hasFocus | get name | first) != 'Nvim' { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace Nvim }; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating } }") (lsft rsft))

  m-, (fork (macro C-A-M-,) (cmd nu -c "let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace-in-direction left; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace-in-direction left; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating }") (lsft rsft))
  m-. (fork (macro C-A-M-.) (cmd nu -c "let w = (^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` query focused | from json | get data.focused); let fl = (($w.state? | default {type: 'none'}).type == 'floating'); if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-tiling }; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command move --workspace-in-direction right; ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command focus --workspace-in-direction right; if $fl { ^`C:\Program Files\glzr.io\GlazeWM\cli\glazewm.exe` command --id $w.id set-floating }") (lsft rsft))
  ;; --- Dead Key Layer Triggers (One-Shot with 2000ms timeout) ---
  os-acu (one-shot 2000 (layer-while-held acute))
  os-grv (one-shot 2000 (layer-while-held grave))
  os-cir (one-shot 2000 (layer-while-held circumflex))
  os-tld (one-shot 2000 (layer-while-held tilde))

  ;; --- Cedilla ---
  ;; Ç: Shift and Alt are let go before the character goes out. With them
  ;; still down, Alt+Shift+C did not give Ç (Caps+Shift+C did); 2026-10-08.
  c-ced (fork (unicode ç)
              (multi (release-key lsft) (release-key rsft) (release-key lalt)
                     (macro 5 (unicode Ç)))
              (lsft rsft))

  ;; --- Acute Accents ---
  a-acu (fork (unicode á) (unicode Á) (lsft rsft))
  e-acu (fork (unicode é) (unicode É) (lsft rsft))
  i-acu (fork (unicode í) (unicode Í) (lsft rsft))
  o-acu (fork (unicode ó) (unicode Ó) (lsft rsft))
  u-acu (fork (unicode ú) (unicode Ú) (lsft rsft))
  c-acu (fork (unicode ç) (unicode Ç) (lsft rsft))

  ;; --- Grave Accents ---
  a-grv (fork (unicode à) (unicode À) (lsft rsft))
  e-grv (fork (unicode è) (unicode È) (lsft rsft))
  i-grv (fork (unicode ì) (unicode Ì) (lsft rsft))
  o-grv (fork (unicode ò) (unicode Ò) (lsft rsft))
  u-grv (fork (unicode ù) (unicode Ù) (lsft rsft))

  ;; --- Circumflex Accents ---
  a-cir (fork (unicode â) (unicode Â) (lsft rsft))
  e-cir (fork (unicode ê) (unicode Ê) (lsft rsft))
  i-cir (fork (unicode î) (unicode Î) (lsft rsft))
  o-cir (fork (unicode ô) (unicode Ô) (lsft rsft))
  u-cir (fork (unicode û) (unicode Û) (lsft rsft))

  ;; --- Tilde Accents ---
  a-tld (fork (unicode ã) (unicode Ã) (lsft rsft))
  o-tld (fork (unicode õ) (unicode Õ) (lsft rsft))
  n-tld (fork (unicode ñ) (unicode Ñ) (lsft rsft))
  e-tld (fork (unicode ẽ) (unicode Ẽ) (lsft rsft))
  ;; --- Shift inside an accent layer (Mia, 2026-10-08) ---
  ;; Alt+E (or Caps+E) arms the accent for the next key pressed, and Shift
  ;; counted as that key: it used up the accent and Shift+E gave a plain E.
  ;; Shift here keeps the accent layer while held, so Alt+E, then Shift+E
  ;; gives É (the letter's fork sees the Shift).
  ls-acute (multi lsft (layer-while-held acute))
  rs-acute (multi rsft (layer-while-held acute))
  ls-grave (multi lsft (layer-while-held grave))
  rs-grave (multi rsft (layer-while-held grave))
  ls-circumflex (multi lsft (layer-while-held circumflex))
  rs-circumflex (multi rsft (layer-while-held circumflex))
  ls-tilde (multi lsft (layer-while-held tilde))
  rs-tilde (multi rsft (layer-while-held tilde))
)

;; ----------------------------------------------------------------------------
;; Base Layer (Default)
;; ----------------------------------------------------------------------------
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    @emoji    /    rsft
  @ctl @win @alt          spc            ralt rmet rctl
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; Editor (komokana: Adobe Editor Pro.exe) - CapsLock tap = Delete
;; ----------------------------------------------------------------------------
(deflayer premiere
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap-del a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  @ctl @win @alt          spc            ralt rmet rctl
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; Zen (komokana: zen.exe) - Win+W = close tab
;; ----------------------------------------------------------------------------
(deflayer zen
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    @emoji    /    rsft
  @ctl @win-zen @alt          spc            ralt rmet rctl
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; CapsLock Navigation & Accent Layer (Active while holding CapsLock)
;; ----------------------------------------------------------------------------
(deflayer caps_nav
  @os-grv _    _    _    _    _    _    _    _    _    _    _    _    del
  _    _    _    @os-acu    @gl-af    _    _    _    @os-cir    _    @gl-pr    _    _    _
  _    _    _    _    _    @gl-sp    lft    down    up    rght    _    _    _
  _    _    _    @c-ced    @gl-nv    @glance    @os-tld    _    _    _    _    _
  _       _    _              _              _    _    _
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; Alt Accent Layer (Active while holding Left Alt)
;; ----------------------------------------------------------------------------
(deflayer alt_accent
  @os-grv _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    @os-acu @a-retile _ _ _  @os-cir _   @a-pause _ _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    @c-ced _  _    @os-tld _ _    _    _    _
  _       _    _              _              _    _    _
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; Command Layer (Active while holding Left Win / Super)
;; macOS Cmd shortcuts + Komorebi window management passthrough
;; ----------------------------------------------------------------------------
;; Win+` (lrld-next, in cmd_layer and cmd_zen): switch to the next config
;; kanata was started with: kanata.cmd.kbd (the vim-like modes, default)
;; and kanata.plain.kbd (without them). Mia, 2026-10-08.
(deflayer cmd_layer
  lrld-next @m-1 @m-2 @m-3  @m-4  @m-5  @m-6  @m-7  @m-8  @m-9  @m-0  _    _    @m-scr
 @w-tab @m-q   @w-cls @expl _    C-t  _    _  @m-i @m-o @m-p      @m-[  @m-]    _
  _     C-a   @c-save @m-desk @m-f  _    @m-h @m-j @m-k @m-l _    _    @m-term
  _      @undo C-x  @c-cpy C-v @m-b  @m-n  @m-mo  @m-,  @m-.  _    _
  _      _    _               @m-ed           _    _    _
  @win-lclick
  @win-rclick
  @win-mclick
)

;; ----------------------------------------------------------------------------
;; Command Layer, Zen variant - only W differs: Ctrl+W instead of closing
;; ----------------------------------------------------------------------------
(deflayer cmd_zen
  lrld-next @m-1 @m-2 @m-3  @m-4  @m-5  @m-6  @m-7  @m-8  @m-9  @m-0  _    _    @m-scr
 @w-tab @m-q   C-w    @expl _    C-t  _    _  @m-i @m-o @m-p      @m-[  @m-]    _
  _     C-a   @c-save @m-desk @m-f  _    @m-h @m-j @m-k @m-l _    _    @m-term
  _      @undo C-x  @c-cpy C-v @m-b  @m-n  @m-mo  @m-,  @m-.  _    _
  _      _    _               @m-ed           _    _    _
  @win-lclick
  @win-rclick
  @win-mclick
)

;; ----------------------------------------------------------------------------
;; Control Navigation Layer (Active while holding Left Ctrl)
;; ----------------------------------------------------------------------------
(deflayer ctrl_nav
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    C-M-lft _ _  C-M-rght _  _    _
  _      _    _    _    @clip _   _    _    _    _    _    _
  _      _    _              _              _    _    _
  _
  _
  _
)

;; ----------------------------------------------------------------------------
;; Dead Key Layers (Activated for 1 keypress via one-shot)
;; ----------------------------------------------------------------------------

;; Acute Accent Layer: Alt+E or Caps+E then letter
(deflayer acute
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-acu _      _      _      @u-acu @i-acu @o-acu _      _      _      _
  _      @a-acu _      _      _      _      _      _      _      _      _      _      _
  @ls-acute      _      _      @c-acu      _      _      _      _      _      _      _      @rs-acute
  _      _      _                    (unicode ´)          _      _      _
  _
  _
  _
)

;; Grave Accent Layer: Alt+` or Caps+` then letter
(deflayer grave
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-grv _      _      _      @u-grv @i-grv @o-grv _      _      _      _
  _      @a-grv _      _      _      _      _      _      _      _      _      _      _
  @ls-grave      _      _      _      _      _      _      _      _      _      _      @rs-grave
  _      _      _                    (unicode `)          _      _      _
  _
  _
  _
)

;; Circumflex Accent Layer: Alt+I or Caps+I then letter
(deflayer circumflex
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-cir _      _      _      @u-cir @i-cir @o-cir _      _      _      _
  _      @a-cir _      _      _      _      _      _      _      _      _      _      _
  @ls-circumflex      _      _      _      _      _      _      _      _      _      _      @rs-circumflex
  _      _      _                    (unicode ^)          _      _      _
  _
  _
  _
)

;; Tilde Accent Layer: Alt+N or Caps+N then letter
(deflayer tilde
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-tld _      _      _      _      _      @o-tld _      _      _      _
  _      @a-tld _      _      _      _      _      _      _      _      _      _      _
  @ls-tilde      _      _      _      _      _      @n-tld      _      _      _      _      @rs-tilde
  _      _      _                    (unicode ~)          _      _      _
  _
  _
  _
)
