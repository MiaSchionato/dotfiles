;; ============================================================================
;;  Kanata Configuration - Ported from AutoHotkey (~/Documents/AutoHotkey)
;;
;;  Features:
;;    1. CapsLock Dual-Role:
;;       - Tap: Esc
;;       - Shift + Tap: Delete
;;       - Hold: caps_nav layer (vim arrows h/j/k/l + dead keys e/`/i/n/c)
;;    2. macOS-Style Dead Keys (Accents):
;;       - Triggerable via CapsLock + [e, `, i, n, c] OR Alt + [e, `, i, n, c]
;;       - Acute (e): á, é, í, ó, ú, Á, É, Í, Ó, Ú, ç, Ç
;;       - Grave (`): à, è, ì, ò, ù, À, È, Ì, Ò, Ù
;;       - Circumflex (i): â, ê, î, ô, û, Â, Ê, Î, Ô, Û
;;       - Tilde (n): ã, õ, ñ, Ã, Õ, Ñ
;;       - Cedilla (c): ç, Ç
;;    3. Windows / Super as Command (Cmd):
;;       - Tap Left Win: Alt+Space (app launcher, suppresses Windows Start menu)
;;       - Hold Left Win: cmd_layer
;;         * Cmd+A -> Ctrl+A
;;         * Cmd+C -> Ctrl+C (Shift+Cmd+C -> Komorebi clear-session-float)
;;         * Cmd+X -> Ctrl+X
;;         * Cmd+V -> Ctrl+V
;;         * Cmd+Z -> Ctrl+Z / Ctrl+Shift+Z
;;         * Cmd+T -> Ctrl+T
;;         * Cmd+W -> Alt+F4 (close window)
;;         * Cmd+Tab -> Alt+Tab (window switcher)
;;         * Passthrough Komorebi navigation (Win+1..5, Win+hjkl, etc.)
;;    4. Ctrl Key Additions:
;;       - Ctrl+H -> Ctrl+Win+Left (Virtual Desktop left)
;;       - Ctrl+L -> Ctrl+Win+Right (Virtual Desktop right)
;;       - Ctrl+V -> Win+V (Windows Clipboard History)
;; ============================================================================

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

;; ----------------------------------------------------------------------------
;; Source Keyboard Layout (Standard 60% ANSI physical keys)
;; ----------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl f13 lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; Aliases & Macros
;; ----------------------------------------------------------------------------
(defalias
  ;; CapsLock: Tap = Esc, Shift+Tap = Delete, Hold = caps_nav layer (See AutoHotkey for esc and delete based on context, that's why its sending a f15 key)
  cap (fork
        (tap-hold-press 200 200 f15 (layer-while-held caps_nav))
        del
        (lsft rsft))

  ;; Left Win / Cmd: Tap = Alt+Space (launcher), Hold = cmd_layer
  win (tap-hold-press 200 200 A-spc (layer-while-held cmd_layer))

  ;; Left Alt: normal Alt + activates alt_accent layer for dead keys
  alt (multi lalt (layer-while-held alt_accent))

  ;; Left Ctrl: normal Ctrl + activates ctrl_nav layer
  ctl (multi lctl (layer-while-held ctrl_nav))

  ;; Clipboard History: releases Ctrl and sends Win+V
  clip (multi (release-key lctl) M-v)

  ;; Command layer aliases
  undo  (fork C-z C-S-z (lsft rsft))
  m-q (macro C-A-M-q)
  ;; w-cls A-f4 ;; for now, it should be ctrl + w when on zen browser
  w-cls f14 ;; See Autohotkey newShortcuts.ahk to understand context
  w-tab C-A-tab
  c-cpy (fork C-c M-S-c (lsft rsft))
  expl M-e
  m-r (macro C-A-M-r) ;; Resolve
  m-p (macro C-A-M-p) ;; Premiere
  m-[ (macro C-A-M-[) ;; cycle-focus
  m-] (macro C-A-M-]) 
  

  m-f (macro C-A-M-f)
  ;; Vim keys move windows focus
  m-h (macro C-A-M-h) ;; using macro to avoid kanata error 
  m-j (macro C-A-M-j)
  m-k (macro C-A-M-k)
  m-l (macro C-A-M-l)

  m-i (macro C-A-M-i) ;; toggle-shortcuts (?)
  m-o (macro C-A-M-o) ;; Reload whkd and Komorebi 

  m-1 (macro C-A-M-1) ;; Workspaces
  m-2 (macro C-A-M-2)
  m-3 (macro C-A-M-3)
  m-4 (macro C-A-M-4)
  m-5 (macro C-A-M-5)
  m-6 (macro C-A-M-6)
  m-7 (macro C-A-M-7)
  m-8 (macro C-A-M-8)
  m-9 (macro C-A-M-9)
  m-0 (macro C-A-M-0)


  m-term (macro C-A-M-ret) ;; terminal
  m-b (macro C-A-M-b) ;; Browser
  m-n (macro C-A-M-n) ;; Nvim
  m-m (macro C-A-M-m) ;; Motion (After effects)

  m-, (macro C-A-M-,)
  m-. (macro C-A-M-.)
  ;; --- Dead Key Layer Triggers (One-Shot with 2000ms timeout) ---
  os-acu (one-shot 2000 (layer-while-held acute))
  os-grv (one-shot 2000 (layer-while-held grave))
  os-cir (one-shot 2000 (layer-while-held circumflex))
  os-tld (one-shot 2000 (layer-while-held tilde))

  ;; --- Cedilla ---
  c-ced (fork (unicode ç) (unicode Ç) (lsft rsft))

  ;; --- Acute Accents ---
  a-acu (fork (unicode á) (unicode Á) (lsft rsft))
  e-acu (fork (unicode é) (unicode É) (lsft rsft))
  i-acu (fork (unicode í) (unicode Í) (lsft rsft))
  o-acu (fork (unicode ó) (unicode Ó) (lsft rsft))
  u-acu (fork (unicode ú) (unicode Ú) (lsft rsft))
  c-acu (fork (unicode ç) (unicode Ç) (lsft rsft))

  ;; --- Grave Accents ---
  a-grv (fork (unicode à) (unicode À) (lsft rsft))
  e-grv (fork (unicode è) (unicode È) (lsft rsft))
  i-grv (fork (unicode ì) (unicode Ì) (lsft rsft))
  o-grv (fork (unicode ò) (unicode Ò) (lsft rsft))
  u-grv (fork (unicode ù) (unicode Ù) (lsft rsft))

  ;; --- Circumflex Accents ---
  a-cir (fork (unicode â) (unicode Â) (lsft rsft))
  e-cir (fork (unicode ê) (unicode Ê) (lsft rsft))
  i-cir (fork (unicode î) (unicode Î) (lsft rsft))
  o-cir (fork (unicode ô) (unicode Ô) (lsft rsft))
  u-cir (fork (unicode û) (unicode Û) (lsft rsft))

  ;; --- Tilde Accents ---
  a-tld (fork (unicode ã) (unicode Ã) (lsft rsft))
  o-tld (fork (unicode õ) (unicode Õ) (lsft rsft))
  n-tld (fork (unicode ñ) (unicode Ñ) (lsft rsft))
  e-tld (fork (unicode ẽ) (unicode Ẽ) (lsft rsft))
)

;; ----------------------------------------------------------------------------
;; Base Layer (Default)
;; ----------------------------------------------------------------------------
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  @ctl @win @alt          spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; CapsLock Navigation & Accent Layer (Active while holding CapsLock)
;; ----------------------------------------------------------------------------
(deflayer caps_nav
  @os-grv _    _    _    _    _    _    _    _    _    _    _    _    del
  _       _    _    @os-acu _ _    _    _    @os-cir _   _    _    _    _
  _       _    _    _    _    _    lft  down up   rght _    _    _
  _       _    _    @c-ced _  _    @os-tld _ _    _    _    _
  _       _    _              _              _    _    _
)

;; ----------------------------------------------------------------------------
;; Alt Accent Layer (Active while holding Left Alt)
;; ----------------------------------------------------------------------------
(deflayer alt_accent
  @os-grv _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    @os-acu _ _    _    _    @os-cir _   _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    @c-ced _  _    @os-tld _ _    _    _    _
  _       _    _              _              _    _    _
)

;; ----------------------------------------------------------------------------
;; Command Layer (Active while holding Left Win / Super)
;; macOS Cmd shortcuts + Komorebi window management passthrough
;; ----------------------------------------------------------------------------
(deflayer cmd_layer
  _      @m-1  @m-2   @m-3   @m-4  @m-5  @m-6  @m-7  @m-8  @m-9  @m-0  _    _    _
 @w-tab @m-q   @w-cls @expl @m-r C-t  _    _    @m-i @m-o @m-p   @m-[  @m-]    _
  _     C-a   C-s   M-d   @m-f  _    @m-h @m-j @m-k @m-l _    _    @m-term
  _      @undo C-x  @c-cpy C-v @m-b  @m-n  @m-m  @m-,  @m-.  _    _
  _      _    _               A-spc           _    _    _
)

;; ----------------------------------------------------------------------------
;; Control Navigation Layer (Active while holding Left Ctrl)
;; ----------------------------------------------------------------------------
(deflayer ctrl_nav
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    C-M-lft _ _  C-M-rght _  _    _
  _      _    _    _    @clip _   _    _    _    _    _    _
  _      _    _              _              _    _    _
)

;; ----------------------------------------------------------------------------
;; Dead Key Layers (Activated for 1 keypress via one-shot)
;; ----------------------------------------------------------------------------

;; Acute Accent Layer: Alt+E or Caps+E then letter
(deflayer acute
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-acu _      _      _      @u-acu @i-acu @o-acu _      _      _      _
  _      @a-acu _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @c-acu _      _      _      _      _      _      _      _
  _      _      _                    (unicode ´)          _      _      _
)

;; Grave Accent Layer: Alt+` or Caps+` then letter
(deflayer grave
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-grv _      _      _      @u-grv @i-grv @o-grv _      _      _      _
  _      @a-grv _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _                    (unicode `)          _      _      _
)

;; Circumflex Accent Layer: Alt+I or Caps+I then letter
(deflayer circumflex
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-cir _      _      _      @u-cir @i-cir @o-cir _      _      _      _
  _      @a-cir _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _                    (unicode ^)          _      _      _
)

;; Tilde Accent Layer: Alt+N or Caps+N then letter
(deflayer tilde
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      @e-tld _      _      _      _      _      @o-tld _      _      _      _
  _      @a-tld _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      @n-tld _      _      _      _      _
  _      _      _                    (unicode ~)          _      _      _
)
