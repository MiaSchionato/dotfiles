{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 1,
  "default_container_padding": 1,
  "border": true,
  "border_width": 1,
  "border_offset": 0,
  "border_colours": {
    "single": "#7aa2f7",
    "stack": "#9ece6a",
    "monocle": "#bb9af7",
    "floating": "#e0af68",
    "unfocused": "#414868"
  },
  "animation": {
    "enabled": true,
    "duration": 200,
    "fps": 120,
    "style": "EaseOutQuad"
  },
  "mouse_follows_focus": true,
  "display_index_preferences": {
    "0": "PHLC34C-5&12b3b874&0&UID4353",
    "1": "YMK477A-5&12b3b874&0&UID4355",
    "2": "RTK3B3A-5&12b3b874&0&UID4352"
  },
  "monitors": [
    {
      "workspace_padding": 1,
      "container_padding": 1,
      "workspaces": [
        {
          "name": "main",
          "layout": "BSP"
        },
        {
          "name": "Nvim",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "nvim-wezterm.exe",
              "matching_strategy": "Contains"
            }
          ]
        },
        {
          "name": "AfterFX",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "AfterFX.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Premiere",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "Adobe Premiere Pro.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Resolve",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "Resolve.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Browser",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "zen.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "Claude",
          "layout": "BSP",
          "workspace_rules": [
            [
              {
                "kind": "Exe",
                "id": "claude.exe",
                "matching_strategy": "Equals"
              },
              {
                "kind": "Class",
                "id": "Chrome_WidgetWin_1",
                "matching_strategy": "Equals"
              }
            ]
          ]
        },
        {
          "name": "WhatsApp",
          "layout": "BSP",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "WhatsApp.Root.exe",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    },
    {
      "workspace_padding": 1,
      "container_padding": 1,
      "workspaces": [
        {
          "name": "right",
          "layout": "BSP"
        }
      ]
    },
    {
      "workspace_padding": 1,
      "container_padding": 1,
      "workspaces": [
        {
          "name": "left",
          "layout": "BSP"
        }
      ]
    }
  ],
  "floating_applications": [
    {
      "kind": "Class",
      "id": "CabinetWClass",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Adobe Premiere Pro.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "AfterFX.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Epidemic Sound.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Numi.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "floatterm",
      "matching_strategy": "Equals"
    }
  ],
  "manage_rules": [
    [
      {
        "kind": "Exe",
        "id": "claude.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Class",
        "id": "Chrome_WidgetWin_1",
        "matching_strategy": "Equals"
      }
    ]
  ],
  "float_rule_placement": "Center",
  "tray_and_multi_window_applications": [
    {
      "kind": "Exe",
      "id": "claude.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "WhatsApp.Root.exe",
      "matching_strategy": "Equals"
    }
  ]
}
